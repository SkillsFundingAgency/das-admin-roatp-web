@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageCourses.UnrestrictedCourseSearchViewModel
@{
    ViewData["Title"] = "Search for the course you want to restrict";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_validationSummary" />
        <form asp-route="@RouteNames.UnrestrictedCourseSearch" method="POST">
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <span class="govuk-caption-xl">View and manage restricted courses</span>
                        <h1 class="govuk-heading-xl">
                            Search for the course you want to restrict
                        </h1>
                    </legend>
                    <input asp-for="Title" id="Title" type="hidden" />
                    <input asp-for="Level" id="Level" type="hidden" />
                    <input asp-for="LarsCode" id="LarsCode" type="hidden" />
                    <p class="govuk-hint">Start typing in the box and its name will appear.</p>
                    <span asp-validation-for="SearchTerm" class="govuk-error-message"></span>
                    <div data-module="govuk-input">
                        <input id="SearchTerm" type="text" title="Type course name here"
                               asp-for="SearchTerm" class="govuk-input" sfa-validationerror-class="form-control-error"
                               data-module="autoComplete"
                               data-autocomplete-url="/unrestricted-courses"
                               data-autocomplete-min-length="1"
                               data-autocomplete-mode="course" />
                        <label for="SearchTerm" class="govuk-visually-hidden">Search Result: @Model.Title</label>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-button-group">
                <button type="submit" id="continue" class="govuk-button" data-disable-on-submit="true">Continue</button>
            </div>
        </form>
    </div>
</div>
