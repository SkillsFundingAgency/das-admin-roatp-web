@model SFA.DAS.Admin.Roatp.Web.Models.ManageCourses.RestrictedCourseDetailsViewModel

<div asp-show="@Model.HasProviders">
    <div class="app-results-header govuk-!-margin-bottom-3">
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">@Model.ProviderCountDescription</p>
        <p class="govuk-body govuk-!-margin-bottom-0">
            Sorted by: <span class="govuk-!-font-weight-bold">Name of provider</span>
        </p>
    </div>

    <ul class="govuk-list app-results-list app-results-list--bordered">
        @foreach (var provider in Model.AllowedProviders)
        {
            <li class="app-results-list__item">
                <div class="app-results-list__content govuk-!-margin-bottom-2">
                    <strong class="govuk-tag @provider.DeliveryStatusTagClass app-tag">@provider.DeliveryStatusDescription</strong>
                    <div class="app-results-list__actions">
                        <a class="govuk-link govuk-link--no-visited-state" href="@provider.ChangeUrl">Change</a>
                    </div>
                </div>
                <h3 class="govuk-heading-m govuk-!-margin-bottom-1">@provider.ProviderName</h3>
                <dl class="das-definition-list das-definition-list--meta govuk-!-margin-bottom-1">
                    <dt class="das-definition-list__title">UKPRN</dt>
                    <dd class="das-definition-list__definition">@provider.Ukprn</dd>
                </dl>
                <dl asp-show="provider.HasLastDateStarts" class="das-definition-list das-definition-list--meta govuk-!-margin-bottom-0">
                    <dt class="das-definition-list__title">Last start date</dt>
                    <dd class="das-definition-list__definition">@provider.LastDateStartsText</dd>
                </dl>
            </li>
        }
    </ul>
</div>

<div asp-show="@Model.HasNoFilterResults">
    <h2 class="govuk-heading-m">No results</h2>
    <p class="govuk-body">There are no training providers that match your search.</p>
    <p class="govuk-body">You may need to:</p>
    <ul class="govuk-list govuk-list--bullet">
        <li>clear filters you've selected</li>
        <li>check your spelling or enter another search term and try again</li>
    </ul>
    <p class="govuk-body">Change your search using the filters on this page.</p>
</div>

<p asp-show="@Model.HasNoProviders" class="govuk-body">No providers offer this course yet.</p>
