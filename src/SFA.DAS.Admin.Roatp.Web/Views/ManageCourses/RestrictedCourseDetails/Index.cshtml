@model SFA.DAS.Admin.Roatp.Web.Models.ManageCourses.RestrictedCourseDetailsViewModel
@{
    ViewBag.Title = $"View and manage restricted courses - {Model.DisplayTitle}";
}

@if (Model.HasSuccessBanner)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                Success
            </h2>
        </div>
        <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
                @Model.SuccessBannerMessage
            </h3>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-xl govuk-!-margin-bottom-2">View and manage restricted courses</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">@Model.DisplayTitle</h1>

        <div class="govuk-summary-list">
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Type</dt>
                <dd class="govuk-summary-list__value">@Model.LearningTypeDescription</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Sector</dt>
                <dd class="govuk-summary-list__value">@Model.Sector</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">LARS code</dt>
                <dd class="govuk-summary-list__value">@Model.LarsCode</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Status</dt>
                <dd class="govuk-summary-list__value">@Model.StatusText</dd>
            </dl>
        </div>
    </div>
</div>

<div class="app-action-panel govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-m">Add a new training provider to this course</h2>
    <p class="govuk-body">We manage the delivery of this course. Adding a new training provider will allow them to add this course to their offering in Course management.</p>
    <a class="govuk-button govuk-!-margin-bottom-0" href="@Model.RestrictedCourseDetailsPageUrl" data-module="govuk-button">
        Add a training provider
    </a>
</div>

<hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-6">

<h2 class="govuk-heading-m">Training providers allowed to offer this course on Find apprenticeship training</h2>

<p class="govuk-body">We use the last date for new starts to open or close courses to different training providers.</p>
<p class="govuk-body">You can stop a training provider from offering this course by adding a last date for new starts.</p>
<p class="govuk-body">You can also change, extend or remove the last start date if you want a training provider to continue delivering it.</p>

<div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-one-third">
        @await Html.PartialAsync("_filters", Model.Filters)
    </div>

    <div class="govuk-grid-column-two-thirds">
        @await Html.PartialAsync("~/Views/ManageCourses/RestrictedCourseDetails/_providerResultCard.cshtml", Model)
        <div class="govuk-!-margin-top-4">
            @await Html.PartialAsync("_pagination", Model.Pagination)
        </div>
    </div>
</div>
