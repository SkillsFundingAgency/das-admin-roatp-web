@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageCourses.UnrestrictedCourseDetailsViewModel
@{
    ViewBag.Title = $"View and manage restricted courses - {Model.DisplayTitle}";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl govuk-!-margin-bottom-2">View and manage restricted courses</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">@Model.DisplayTitle</h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-summary-list">
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Type</dt>
                <dd class="govuk-summary-list__value">@Model.LearningTypeDescription</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Sector</dt>
                <dd class="govuk-summary-list__value">@Model.Sector</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">LARS code</dt>
                <dd class="govuk-summary-list__value">@Model.LarsCode</dd>
            </dl>
            <dl class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Status</dt>
                <dd class="govuk-summary-list__value">@Model.StatusText</dd>
            </dl>
        </div>
    </div>
</div>

<div class="app-action-panel govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-l">Is this the right course?</h2>
    <p class="govuk-body">Restricting a course will not impact training providers who have it added in Course management.
        Any training providers who currently deliver it will be automatically added to the approved list.
        Restricting a course will stop new training providers from adding it to their account in Course management.
    </p>
    <form method="get" action="@Model.RestrictCourseUrl" class="govuk-!-margin-bottom-0">
        <button type="submit" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">
            Restrict this course
        </button>
    </form>
</div>

<hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-6">

<h2 class="govuk-heading-l">Training providers currently offering this course on Find apprenticeship training</h2>

<div asp-show="Model.HasNoProviders">
    <p class="govuk-body">There are currently no providers offering this course.</p>
    <p class="govuk-body">If you want to add any providers to this list, you will need to restrict the course.</p>
</div>

<div asp-show="Model.HasProviders">
    <p class="govuk-body">If you want to remove or add any providers on this list, you will need to restrict the course.</p>

    <div class="app-results-header govuk-!-margin-top-6 govuk-!-margin-bottom-3">
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">@Model.ProviderCountDescription</p>
        <p class="govuk-body govuk-!-margin-bottom-0">
            Sorted by: <span class="govuk-!-font-weight-bold">Name of provider</span>
        </p>
    </div>

    <ul class="govuk-list app-results-list app-results-list--bordered">
        @foreach (var provider in Model.Providers)
        {
            <li class="app-results-list__item">
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1">@provider.ProviderName</h3>
                <dl class="das-definition-list das-definition-list--meta govuk-!-margin-bottom-0">
                    <dt class="das-definition-list__title">UKPRN</dt>
                    <dd class="das-definition-list__definition">@provider.Ukprn</dd>
                </dl>
            </li>
        }
    </ul>
</div>
