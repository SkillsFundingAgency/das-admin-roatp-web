@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageCourses.ConfirmAddProviderToRestrictedCourseViewModel

@{
    ViewBag.Title = "Confirm that you want to allow this provider to offer this course";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl">Add a training provider</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">
            Confirm that you want to allow this provider to offer this course
        </h1>
    </div>

    <div class="govuk-grid-column-two-thirds">

        <p class="govuk-body">
            This means the training provider will be able to add this course to their account in Course management
            and offer it in Find apprenticeship training.
        </p>

        <div class="app-action-panel govuk-!-margin-bottom-6">
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">@Model.ProviderName</p>
            <p class="govuk-body govuk-!-margin-bottom-0">UKPRN @Model.Ukprn</p>
        </div>


        <form asp-route="@RouteNames.ConfirmAddProviderToRestrictedCourse" asp-route-larsCode="@Model.LarsCode" method="post">
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-disable-on-submit="true" data-module="govuk-button">
                    Confirm
                </button>
                <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

