@using Humanizer
@using SFA.DAS.Admin.Roatp.Web.Extensions
@using SFA.DAS.Admin.Roatp.Web.Models.ManageRestrictedProvider
@model AllowedCoursesViewModel
@{
    var learningTypeName = Model.RouteLearningType.GetDescription().Transform(To.LowerCase);
    var learningTypeNamePlural = learningTypeName.Pluralize();
    var pageHeading = $"Manage {learningTypeNamePlural} this provider is allowed to deliver";
    ViewData["Title"] = pageHeading;
}

@if (Model.HasSuccessBanner)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                Success
            </h2>
        </div>
        <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
                @Model.SuccessBannerMessage
            </h3>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl">@Model.ProviderName</span>
        <h1 class="govuk-heading-xl">@pageHeading</h1>

        <p asp-show="Model.IsApprenticeshipUnit" class="govuk-body">This page shows the @learningTypeNamePlural the provider is allowed to deliver. You can add or remove @learningTypeNamePlural.</p>
        <p asp-show="Model.IsApprenticeship" class="govuk-body">This provider's account permissions mean that they can only offer courses we have added to their account.</p>
    </div>
</div>

<div class="app-action-panel govuk-!-margin-bottom-8 govuk-!-margin-top-2">
    <h2 class="govuk-heading-l">Add an @learningTypeName</h2>
    <p class="govuk-body">Adding a new @learningTypeName will allow this provider to add it to their account in Course management.</p>
    <p class="govuk-body">If they add it in Course management, they will be able to offer it to learners on Find apprenticeship training.</p>
    <a class="govuk-button govuk-!-margin-bottom-0" href="@Model.AddUrl" data-module="govuk-button">Add an @learningTypeName</a>
</div>

<hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-6">

<h2 class="govuk-heading-l">@learningTypeNamePlural.ApplyCase(LetterCasing.Sentence) this provider can deliver</h2>

<p asp-show="Model.HasNoCourses" class="govuk-body">There are currently no @learningTypeNamePlural added to this list.</p>
<p asp-show="Model.HasCourses" class="govuk-body">This is a list of what courses this provider can add to their account in Course management and offer in Find apprenticeship training.</p>

<div asp-show="Model.HasCourses" class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-two-thirds">
        <div class="app-results-header govuk-!-margin-bottom-3">
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">@Model.TotalCountDescription</p>
            <p class="govuk-body govuk-!-margin-bottom-0">
                Sorted by: <span class="govuk-!-font-weight-bold">Name of course</span>
            </p>
        </div>

        <ul class="govuk-list app-results-list app-results-list--bordered">
            @foreach (var course in Model.Courses)
            {
                <li class="app-results-list__item">
                    <div class="app-results-list__content govuk-!-margin-bottom-2">
                        <strong class="govuk-tag @course.DeliveryStatusTagClass app-tag">@course.DeliveryStatusDescription</strong>
                        <div class="app-results-list__actions">
                            <a class="govuk-link govuk-link--no-visited-state" href="@course.ChangeUrl">Change</a>
                        </div>
                    </div>
                    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">@course.DisplayTitle</h3>
                    <p class="govuk-body govuk-!-margin-bottom-0">LARS Code: @course.LarsCode</p>
                </li>
            }
        </ul>
    </div>
</div>
