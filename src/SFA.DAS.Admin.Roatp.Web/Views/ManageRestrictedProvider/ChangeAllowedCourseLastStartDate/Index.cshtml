@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@using SFA.DAS.Admin.Roatp.Web.Models.ManageRestrictedProvider
@model ChangeAllowedCourseLastStartDateViewModel
@{
    ViewData["Title"] = "What would you like to change?";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <partial name="_validationSummary" />
        <span class="govuk-caption-xl">Change last start date</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">What would you like to change?</h1>
        <p class="govuk-body">
            <strong>@Model.CourseDisplayTitle</strong> currently has a last start date set of <strong>@Model.LastDateStartsText</strong>.
        </p>
    </div>

    <div class="govuk-grid-column-two-thirds">
        <form asp-route="@RouteNames.ChangeAllowedCourseLastStartDate"
              asp-route-ukprn="@Model.Ukprn"
              asp-route-routeLearningType="@Model.RouteLearningType"
              asp-route-larsCode="@Model.LarsCode"
              method="post"
              novalidate>
            <div esfa-validation-marker-for="SelectedOption" class="govuk-form-group" id="SelectedOption">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-visually-hidden">What would you like to change?</legend>
                    <span asp-validation-for="SelectedOption" class="govuk-error-message"></span>
                    <div class="govuk-radios" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="selected-option-change"
                                   name="@nameof(Model.SelectedOption)"
                                   type="radio"
                                   value="@ChangeAllowedCourseLastStartDateOptions.Change"
                            @(Model.SelectedOption == ChangeAllowedCourseLastStartDateOptions.Change ? "checked" : null)>
                            <label class="govuk-label govuk-radios__label" for="selected-option-change">
                                Change last start date
                            </label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="selected-option-remove"
                                   name="@nameof(Model.SelectedOption)"
                                   type="radio"
                                   value="@ChangeAllowedCourseLastStartDateOptions.Remove"
                                   aria-describedby="selected-option-remove-hint"
                            @(Model.SelectedOption == ChangeAllowedCourseLastStartDateOptions.Remove ? "checked" : null)>
                            <label class="govuk-label govuk-radios__label" for="selected-option-remove">
                                Remove last start date
                            </label>
                            <div id="selected-option-remove-hint" class="govuk-hint govuk-radios__hint">
                                This means the provider can continue to offer the course with no set end date
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button" data-disable-on-submit="true">
                    Continue
                </button>
                <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>
