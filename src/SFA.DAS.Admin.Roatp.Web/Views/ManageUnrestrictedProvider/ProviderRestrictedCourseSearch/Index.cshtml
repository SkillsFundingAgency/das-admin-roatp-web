@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageUnrestrictedProvider.ProviderRestrictedCourseSearchViewModel
@{
    ViewData["Title"] = "Search for the course you want to restrict";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_validationSummary" />
        <span class="govuk-caption-xl">Restrict a course</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">
            Search for the course you want to restrict
        </h1>
        <p class="govuk-body">
            Restricting a course will stop this training provider from adding it to their account in Course management.
        </p>
        <p class="govuk-body">
            If they currently offer it, you will need to add a last date for new starts. If the provider submits an ILR for a learner who starts after this date, it will be rejected.
        </p>
        <form asp-route="@RouteNames.RestrictCourseSearch" asp-route-ukprn="@Model.Ukprn" method="POST" novalidate>
            <div esfa-validation-marker-for="SelectedLarsCode" class="govuk-form-group">
                <label class="govuk-visually-hidden" asp-for="SelectedLarsCode">
                    Start typing in the box and its name will appear
                </label>
                <div class="govuk-hint">
                    Start typing in the box and its name will appear.
                </div>
                <span asp-validation-for="SelectedLarsCode" class="govuk-error-message"></span>
                <select asp-for="SelectedLarsCode"
                        asp-items="@Model.Courses"
                        class="govuk-select app-autocomplete"
                        data-min-length="1">
                    <option value="" disabled selected></option>
                </select>
            </div>
            <div class="govuk-button-group">
                <button type="submit" id="continue" class="govuk-button" data-disable-on-submit="true">Continue</button>
            </div>
        </form>
    </div>
</div>
