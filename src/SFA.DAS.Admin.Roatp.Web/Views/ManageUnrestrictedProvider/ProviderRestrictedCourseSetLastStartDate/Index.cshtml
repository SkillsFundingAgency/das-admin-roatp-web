@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageUnrestrictedProvider.ProviderRestrictedCourseSetLastStartDateViewModel
@{
    ViewData["Title"] = $"Stop {Model.ProviderName} from delivering this course";
    var dateError = ViewData.ModelState[nameof(Model.Day)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasDateError = !string.IsNullOrEmpty(dateError);
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <partial name="_validationSummary" />
        <span class="govuk-caption-xl">Restrict a course</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">
            Stop @Model.ProviderName from delivering this course
        </h1>
    </div>
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body">
            Adding a last date for new starts will close this course to new learners.
        </p>
        <p class="govuk-body">After this date has passed, the training provider will not be able to:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>add new government funded learners</li>
            <li>advertise it on Find apprenticeship training</li>
            <li>submit ILRs to claim government funding for new learners</li>
        </ul>
        <p class="govuk-body">
            The provider can continue to train and claim funding for learners who are already on the course.
        </p>
        <div class="app-action-panel govuk-!-margin-bottom-6">
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">@Model.CourseDisplayTitle</p>
            <p class="govuk-body govuk-!-margin-bottom-0">LARS Code: @Model.LarsCode</p>
        </div>

        <form asp-route="@RouteNames.ProviderRestrictedCourseSetLastStartDate"
              asp-route-ukprn="@Model.Ukprn"
              method="post"
              novalidate>
            <div class="govuk-form-group @(hasDateError ? "govuk-form-group--error" : string.Empty)">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="last-date-starts-hint@(hasDateError ? " last-date-starts-error" : string.Empty)">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Last date for new starts</h2>
                    </legend>
                    <div id="last-date-starts-hint" class="govuk-hint">
                        Add the last date for new starts. The provider will not be able to add new learners to the course after this date.
                    </div>
                    <p asp-show="@hasDateError" id="last-date-starts-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @dateError
                    </p>
                    <div class="govuk-date-input" id="last-date-starts">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" asp-for="Day">Day</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(hasDateError ? "govuk-input--error" : string.Empty)"
                                       asp-for="Day"
                                       id="Day"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="2"
                                       autocomplete="bday-day">
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" asp-for="Month">Month</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(hasDateError ? "govuk-input--error" : string.Empty)"
                                       asp-for="Month"
                                       id="Month"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="2"
                                       autocomplete="bday-month">
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" asp-for="Year">Year</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-4 @(hasDateError ? "govuk-input--error" : string.Empty)"
                                       asp-for="Year"
                                       id="Year"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="4"
                                       autocomplete="bday-year">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button" data-disable-on-submit="true">
                    Confirm restriction
                </button>
                <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>
