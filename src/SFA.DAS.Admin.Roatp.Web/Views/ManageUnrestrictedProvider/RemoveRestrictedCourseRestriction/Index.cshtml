@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageUnrestrictedProvider.RemoveRestrictedCourseRestrictionViewModel
@{
    ViewData["Title"] = "Confirm that you want to remove the last date for new starts";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl">Remove restriction</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">
            Confirm that you want to remove the last date for new starts
        </h1>
    </div>
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body">
            If this provider has a last start date set, removing the restriction will also remove this date.
        </p>
        <p class="govuk-body">
            Removing the last date for new starts means this provider can offer this course indefinitely.
        </p>
        <p class="govuk-body">
            They will be able to add it to their account in Course management and offer it to learners on Find apprenticeship training.
        </p>
        <div class="app-action-panel govuk-!-margin-bottom-6">
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">@Model.CourseDisplayTitle</p>
            <p class="govuk-body govuk-!-margin-bottom-0">LARS Code: @Model.LarsCode</p>
        </div>
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                If you choose to remove this course restriction, this training provider will be able to add it to their account in Course management.
            </strong>
        </div>
        <form asp-route="@RouteNames.RemoveRestrictedCourseRestriction"
              asp-route-ukprn="@Model.Ukprn"
              asp-route-larsCode="@Model.LarsCode"
              method="post">
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button" data-disable-on-submit="true">
                    Remove restriction
                </button>
                <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>
