@using SFA.DAS.Admin.Roatp.Web.Infrastructure
@model SFA.DAS.Admin.Roatp.Web.Models.ManageUnrestrictedProvider.RestrictProviderViewModel
@{
    ViewData["Title"] = "Change how we manage this provider's delivery";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl">Change how we manage this provider</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">Change how we manage this provider's delivery</h1>
    </div>
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body">Currently <strong>@Model.ProviderName</strong> is allowed to add any apprenticeship to their account in Course management.</p>
        <p class="govuk-body">Choosing to control their delivery means we need to approve what training they're allowed to offer <strong>before</strong> they can add it in Course management.</p>

        <h2 class="govuk-heading-m">What this means for training providers</h2>
        <p class="govuk-body">Controlling provider delivery:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>will not stop them from delivering courses they currently offer</li>
            <li>will not change what courses they advertise on Find apprenticeship training.</li>
        </ul>
        <p class="govuk-body">Any courses they offer right now will be automatically set to approval and shown as 'open to new starts'.</p>
        <p class="govuk-body">However, we need to add future courses to their account before they can add it to their offering.</p>
        <p class="govuk-body govuk-!-font-weight-bold">This action cannot be reversed.</p>

        <form asp-route="@RouteNames.RestrictProvider" asp-route-ukprn="@Model.Ukprn" method="post">
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button" data-disable-on-submit="true">
                    Control provider delivery
                </button>
                <a class="govuk-link" href="@Model.CancelUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>
